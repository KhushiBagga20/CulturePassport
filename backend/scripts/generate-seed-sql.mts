// Generates db/seed.sql from the TypeScript seed archive.
// Run: npm run seed:sql   (or: node scripts/generate-seed-sql.mts --stdout)
import { writeFileSync } from "node:fs";
import { seedArchive, validateArchive } from "../../src/lib/data/seed/index.ts";
import { archiveToRows, GLOBAL_TABLES, TRADITION_CHILD_TABLES, LATE_TABLES } from "../../src/lib/data/rows.ts";

const DELIM = "$cp$";

export function rowsToSql(rows: Record<string, Record<string, unknown>[]>, tables: readonly string[]): string {
  const out: string[] = [];
  for (const table of tables) {
    const list = rows[table] ?? [];
    if (!list.length) continue;
    const cols = Object.keys(list[0]);
    const json = JSON.stringify(list);
    if (json.includes(DELIM)) throw new Error(`Delimiter collision in ${table}`);
    const colList = cols.map((c) => `"${c}"`).join(", ");
    out.push(
      `insert into ${table} (${colList})\n  select ${colList} from jsonb_populate_recordset(null::${table}, ${DELIM}${json}${DELIM}::jsonb)\n  on conflict do nothing;`,
    );
  }
  return out.join("\n\n");
}

const errors = validateArchive(seedArchive);
if (errors.length) {
  console.error(errors.join("\n"));
  process.exit(1);
}
const rows = archiveToRows(seedArchive);
const order = [...GLOBAL_TABLES, "traditions", ...TRADITION_CHILD_TABLES, ...LATE_TABLES];
const total = order.reduce((n, t) => n + (rows[t]?.length ?? 0), 0);
const sql = [
  "-- Generated by scripts/generate-seed-sql.mts. Do not edit by hand.",
  `-- Seed content for Culture Passport: ${seedArchive.traditions.length} passports, ${seedArchive.sources.length} sources, ${total} rows.`,
  "begin;",
  "",
  rowsToSql(rows, order),
  "",
  "commit;",
  "",
].join("\n");

if (process.argv.includes("--stdout")) process.stdout.write(sql);
else {
  writeFileSync(new URL("../db/seed.sql", import.meta.url), sql);
  console.log(`Wrote db/seed.sql (${total} rows across ${order.length} tables)`);
}
