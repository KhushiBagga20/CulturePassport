# ─── Culture Passport configuration ───────────────────────────────────────────
# Copy to .env.local and fill in. Nothing here is required for local demo mode
# except DEMO_ADMIN_PASSWORD (to unlock the editorial desk).

# Public origin used in QR codes, share links, sitemaps and Open Graph tags.
# Leave empty in development: QR codes then use the address you browse on.
NEXT_PUBLIC_SITE_URL=

# ── Local demo mode (no database) ──
# Passcode for /admin when Supabase is not configured. Choose a long random value.
DEMO_ADMIN_PASSWORD=
# Optional extra secret mixed into the session signature.
DEMO_SESSION_SECRET=

# ── Supabase (production) ──
# When both are set, the app reads and writes Supabase instead of the local seed.
# Use the public "anon" / "publishable" key only. Never put a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
