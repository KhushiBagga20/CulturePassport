# ─── Culture Passport configuration ───────────────────────────────────────────
# Copy to .env.local and fill in. Only EDITOR_PASSCODE is needed to use the editorial desk.

# Public origin used in QR codes, share links, sitemaps and Open Graph tags.
# Leave empty in development: QR codes then use the address you browse on.
NEXT_PUBLIC_SITE_URL=

# ── Editor sign-in ──
# Passcode for /admin. Choose a long random value. (DEMO_ADMIN_PASSWORD is still accepted.)
EDITOR_PASSCODE=
# Optional extra secret mixed into the session signature.
EDITOR_SESSION_SECRET=

# ── Editing on Vercel without a database (optional) ──
# A fine-grained GitHub token with "Contents: Read and write" on this repository only, and the
# repository as owner/name. /admin then saves each edit as a commit (takes priority over DATABASE_URL).
GITHUB_CONTENT_TOKEN=
GITHUB_CONTENT_REPO=

# ── Database (optional) ──
# Without it the site stores edits in .data/ (fine for one server with a persistent disk).
# With a PostgreSQL connection string (for example from Neon) it reads and writes the database.
# Server-only: never give it a NEXT_PUBLIC_ name. Then run `npm run db:setup` once.
DATABASE_URL=
