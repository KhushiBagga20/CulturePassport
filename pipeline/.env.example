# Server-only settings for the research pipeline and database setup. Copy to pipeline/.env (git-ignored).
# Leave both empty to write to the local review queue (.data/research.json).
#
# SUPABASE_SERVICE_ROLE_KEY bypasses row-level security. Keep it here only: never give it a
# NEXT_PUBLIC_ name and never add it to the web app's environment or hosting dashboard.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string for `npm run db:setup` (migrations, seed, editors).
# Dashboard → Connect → connection string; replace [YOUR-PASSWORD] with your database password.
SUPABASE_DB_URL=
