{
  "name": "culture-passport",
  "version": "0.1.0",
  "private": true,
  "description": "Culture Passport \u2014 a living atlas and attribution layer for cultural heritage. When culture travels, let its story travel with it.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "seed:sql": "node backend/scripts/generate-seed-sql.mts",
    "validate": "node backend/scripts/validate-archive.mts",
    "test:db": "node backend/scripts/test-db-roundtrip.mts",
    "research": "node --env-file-if-exists=.env.local --env-file-if-exists=backend/pipeline/.env backend/pipeline/run.mts",
    "test:research": "node backend/pipeline/test.mts",
    "db:setup": "node --env-file-if-exists=.env.local --env-file-if-exists=backend/pipeline/.env backend/scripts/db-setup.mts",
    "research:publish": "node --env-file-if-exists=.env.local --env-file-if-exists=backend/pipeline/.env backend/scripts/publish-research.mts",
    "snapshot:build": "node --env-file-if-exists=.env.local backend/scripts/build-snapshot.mts",
    "snapshot:export": "node --env-file-if-exists=.env.local backend/scripts/build-snapshot.mts --from-db",
    "check:research": "node backend/scripts/check-research.mts",
    "db:load-snapshot": "node --env-file-if-exists=.env.local backend/scripts/db-load-snapshot.mts",
    "test:github-store": "node backend/scripts/test-github-store.mts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "d3-geo": "^3.1.2",
    "gsap": "^3.15.1",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.187.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "@types/topojson-client": "^3.1.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": "24.x"
  }
}
